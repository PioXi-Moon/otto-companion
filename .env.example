# 复制这个文件为 .env，然后填入自己的 Key

# DeepSeek（必填）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 端口
OTTO_PORT=7788

# 用假模型跑通链路（不消耗 API 额度，用于验证记忆与 open loop 是否工作）
# 1 = 开启
OTTO_MOCK_LLM=0

# 主动发起（open loop 到期时主动开口）
OTTO_PROACTIVE=1
