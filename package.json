{
  "name": "otto-companion",
  "productName": "Otto",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Otto AI Companion - 第一阶段软件 Demo",
  "main": "electron/main.mjs",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.mjs",
    "smoke": "node scripts/smoke.mjs",
    "electron": "electron .",
    "mock": "node --disable-warning=ExperimentalWarning --env-file=.env server/index.mjs",
    "vocab:build": "node scripts/build-vocabulary.mjs",
    "shot": "electron scripts/shot.mjs",
    "dist": "electron-builder --win portable",
    "icon": "node scripts/make-icon.mjs",
    "package:zip": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-portable.ps1"
  },
  "devDependencies": {
    "electron": "^44.7.0"
  }
}
